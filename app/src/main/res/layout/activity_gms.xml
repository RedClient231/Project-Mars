<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <include
            android:id="@+id/toolbar_layout"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar_layout">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

            <!-- Play Games Missing Warning -->
            <LinearLayout
                    android:id="@+id/playGamesWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/warning_red_background"
                    android:padding="16dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/warningTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/warning_red"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/gms_play_games_missing" />

                <TextView
                        android:id="@+id/warningDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/warning_red"
                        android:textSize="14sp"
                        android:text="@string/gms_play_games_missing_fix" />

                <Button
                        android:id="@+id/btnImportPlayGames"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/gms_import_play_games"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/warning_red"
                        android:textColor="@color/white" />
            </LinearLayout>

            <!-- Game Login Ready Status -->
            <LinearLayout
                    android:id="@+id/readinessStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/success_green_background"
                    android:padding="16dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/readinessText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/success_green"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:text="@string/gms_game_login_readiness" />
            </LinearLayout>

            <!-- User list -->
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            <!-- Diagnostics section -->
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gms_diagnostics_section"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp" />

            <!-- GMS + Readiness Diagnostic button -->
            <Button
                    android:id="@+id/btnCopyDiagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/gms_copy_diagnostic"
                    android:textAllCaps="false" />

            <!-- Account Diagnostic button -->
            <Button
                    android:id="@+id/btnCopyAccountDiagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/gms_copy_account_diagnostic"
                    android:textAllCaps="false" />

            <!-- Authenticator Diagnostic button -->
            <Button
                    android:id="@+id/btnCopyAuthenticatorDiagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/gms_copy_authenticator_diagnostic"
                    android:textAllCaps="false" />

            <!-- Add Google Account test button -->
            <Button
                    android:id="@+id/btnAddGoogleAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/gms_add_google_account"
                    android:textAllCaps="false" />

            <!-- Test Google Account Visibility button -->
            <Button
                    android:id="@+id/btnTestAccountVisibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/gms_test_account_visibility"
                    android:textAllCaps="false" />

            <!-- Launch Test button -->
            <Button
                    android:id="@+id/btnTestLaunchPlayGames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/gms_test_launch_play_games"
                    android:textAllCaps="false" />

            <!-- Runtime Diagnostic button -->
            <Button
                    android:id="@+id/btnCopyRuntimeDiagnostic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/gms_copy_runtime_diagnostic"
                    android:textAllCaps="false" />

            <!-- Import Play Games button (bottom) -->
            <Button
                    android:id="@+id/btnImportPlayGames2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/gms_import_play_games"
                    android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
